    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "auth:schema": "dotenv -e .env.local -- npx @better-auth/cli generate --config src/lib/auth.ts --output src/db/schema/auth.ts",
    "create-user": "dotenv -e .env.local -- tsx scripts/create-user.ts"
  },
  "browserslist": "defaults, not ie <= 11",
